# ========================================================
# SAKTHI GARMENTS — Spring Boot Backend Environment
# ========================================================

# Active Spring Profile: 'dev' (H2 in-memory zero-config) or 'mysql' (Production)
SPRING_PROFILES_ACTIVE=dev

# Standard MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sakthi_garments
DB_USERNAME=root
DB_PASSWORD=root

# Legacy Aliases (Supported for Docker Compose)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sakthi_garments
MYSQL_USER=root
MYSQL_PASSWORD=root

# Optional Legacy MongoDB Migration Source
# If migrating from an existing MongoDB instance:
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=sakthi_garments_legacy

# Google Gemini AI API Key
GEMINI_API_KEY=

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_sakthi_dev
RAZORPAY_KEY_SECRET=mock_secret_for_local_dev

# Server Port
SERVER_PORT=8080
