# ========================================================
# SAKTHI GARMENTS — Global Monorepo Environment Variables
# Copy this file to .env and adjust variables as required
# ========================================================

# --- Application Profile & Ports ---
NODE_ENV=development
PORT=8080
FRONTEND_PORT=5173

# --- MySQL 8 Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sakthi_garments
DB_USERNAME=root
DB_PASSWORD=root

# Docker Compose Aliases
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sakthi_garments
MYSQL_USER=root
MYSQL_PASSWORD=root

# --- Optional MongoDB Migration Source ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=sakthi_garments_legacy

# --- JWT Authentication ---
JWT_SECRET=sakthi_garments_ultra_secure_jwt_signing_secret_key_tiruppur_2026_super_long_key
JWT_EXPIRATION_MS=86400000

# --- Google Gemini AI API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=rzp_test_sakthi_dev
RAZORPAY_KEY_SECRET=mock_secret_for_local_dev

# --- Frontend API Proxy URL ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
